@inherits FavoriteMoviesBase
@rendermode InteractiveServer

@page "/favoritemovies"

<div class="container">

    <h1>My Favorite Movies</h1>

    <div class="album py-5">
        <div class="container">
            <div class="row row-cols-1 row-cols-sm-1 row-cols-md-1 g-3">
                @if (FavoriteMovies is not null)
                {
                    @foreach (var movie in FavoriteMovies)
                    {
                        <div class="col-12">
                            <div class="card w-100">
                                @movie.Title
                                <div class="card-body">
                                    <p class="card-text">@movie.Overview</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => RemoveFromFavorites(movie)">Remove from Favorites</button>
                                        </div>
                                        <small class="text-muted">@movie.ReleaseDate.ToShortDateString()</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
       
        </div>
    </div>
</div>

                                            
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div class="toast @(showToast ? "show" : "")">
        <div class="toast-header">
            <strong class="me-auto">Movie Collection</strong>
            <button type="button"
                    class="btn-close"
                    @onclick="HideToast">
            </button>
        </div>

        <div class="toast-body">
            @toastMessage
        </div>
    </div>
</div>