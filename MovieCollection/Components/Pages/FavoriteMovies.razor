@using MovieCollection.Components.Shared
@inherits FavoriteMoviesBase

@page "/favoritemovies"

<div class="container">

    <div class="row">
        <div class="col-lg-12">
            <h1 class="mt-3">My Favorite Movies</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="row g-3 align-items-end">
                <div class="col-lg-5 col-md-6 col-sm-12">
                    <label class="form-label">Search by Title:</label>
                    <InputText class="form-control" @bind-Value="SearchTitle" />
                </div>
                <div class="col-lg-3 col-md-3 col-sm-12">
                    <label class="form-label">Search by Year:</label>
                    <InputNumber class="form-control" @bind-Value="SearchYear" />
                </div>
                <div class="d-grid gap-2 col-lg-2 col-sm-12 mx-auto">
                    <button type="button" class="btn btn-primary" @onclick="() => LoadPage(1)">Filter Movies</button>
                </div>
                <div class="d-grid gap-2 col-lg-2 col-sm-12 mx-auto">
                    <button type="button" class="btn btn-secondary" @onclick="ClearFavoriteMovieFilters">Clear Filters</button>
                </div>
            </div>
        </div>
    </div>

    <div class="py-5">
        <div class="row row-cols-1 row-cols-sm-1 row-cols-md-1 g-3">

            @if (PagedMovies is not null && PagedMovies.Count > 0)
            {
                <Pagination CurrentPage="@CurrentPage" SearchTitle="@SearchTitle" TotalPages="@TotalPages" PageChanged="LoadPage" />

                @foreach (var movie in PagedMovies)
                {
                    <div class="col-lg-4">
                        <div class="card w-100 h-100">
                            <div class="card-body d-flex flex-column">
                                <div class="row mb-2">
                                    <div class="col-lg-10 col-md-12 col-sm-12">
                                        <h5 class="card-title">@movie.Title <small class="text-muted">(@(movie.ReleaseDate.Year))</small></h5>
                                    </div>
                                    <div class="col-lg-2 col-md-12 col-sm-12 text-end">
                                        <div class="btn-group">
                                            <i role="button" class="bi bi-x-circle-fill text-danger" style="font-size: 1.25rem;" @onclick="() => OpenModal(movie)" title="Remove from Favorites"></i>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12">
                                        <p class="card-text">
                                            @(ExpandedMovies.Contains(movie.ExternalId) || movie.Overview.Length <= 150
                                                ? movie.Overview
                                                : movie.Overview[..150] + "...")
                                            @if (movie.Overview.Length > 150)
                                            {
                                                <span class="btn btn-link"
                                                      @onclick="() => ToggleText(movie.ExternalId)">
                                                    @if (ExpandedMovies.Contains(movie.ExternalId))
                                                    {
                                                        <i class='bi bi-dash-circle' title="View Less"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class='bi bi-plus-circle' title="View More"></i>
                                                    }
                                                </span>
                                            }
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <Pagination CurrentPage="@CurrentPage" SearchTitle="@SearchTitle" TotalPages="@TotalPages" PageChanged="LoadPage" />

                @if (ShowModal && SelectedMovie is not null)
                {
                    <div class="modal fade show d-block" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h1 class="modal-title fs-5">Confirm Removal</h1>
                                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModal"></button>
                                </div>
                                <div class="modal-body text-center">
                                    Are you sure you want to remove <strong>@SelectedMovie.Title</strong> from your favorites?
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                                    <button type="button" class="btn btn-primary" @onclick="ConfirmRemove">Remove from Favorites</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

        </div>

    </div>

</div>                                         