@using MovieCollection.Components.Shared
@inherits FavoriteMoviesBase
@rendermode InteractiveServer

@page "/favoritemovies"

<div class="container">

    <div class="row">
        <div class="col-lg-12">
            <h1 class="mt-3">My Favorite Movies</h1>
        </div>
    </div>

    <div class="py-5">
        <div class="row row-cols-1 row-cols-sm-1 row-cols-md-1 g-3">
           
            <Pagination CurrentPage="@CurrentPage" SearchTitle="@SearchTitle" TotalPages="@TotalPages" PageChanged="LoadPage" />

            @if (FavoriteMovies is not null)
            {
                @foreach (var movie in FavoriteMovies)
                {
                    <div class="col-12">
                        <div class="card w-100">
                            <div class="card-body">
                                <div class="row mb-2">
                                    <div class="col-lg-4 col-md-12 col-sm-12">
                                        <h5>@movie.Title <small class="text-muted">(@movie.ReleaseDate.Year)</small></h5>
                                    </div>
                                    <div class="col-lg-8 col-md-12 col-sm-12 text-end">
                                        <div class="btn-group">
                                            <i role="button" class="bi bi-x-circle-fill text-danger" style="font-size: 1.25rem;" @onclick="() => OpenModal(movie)" title="Remove from Favorites"></i>
                                            @if (ShowModal)
                                            {
                                                <div class="modal fade show d-block" tabindex="-1" aria-hidden="true">
                                                    <div class="modal-dialog">
                                                        <div class="modal-content">
                                                            <div class="modal-header">
                                                                <h1 class="modal-title fs-5">Confirm Removal</h1>
                                                                <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModal"></button>
                                                            </div>
                                                            <div class="modal-body text-center">
                                                                Are you sure you want to remove <strong>@SelectedMovie.Title</strong> from your favorites?
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                                                                <button type="button" class="btn btn-primary" @onclick="() => RemoveFromFavorites(SelectedMovie)">Remove from Favorites</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-lg-12 col-md-12 col-sm-12">
                                        <p class="card-text">@movie.Overview</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

            <Pagination CurrentPage="@CurrentPage" SearchTitle="@SearchTitle" TotalPages="@TotalPages" PageChanged="LoadPage" />

        </div>

    </div>

</div>

                                            
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div class="toast @(showToast ? "show" : "")">
        <div class="toast-header">
            <strong class="me-auto">Movie Collection</strong>
            <button type="button"
                    class="btn-close"
                    @onclick="HideToast">
            </button>
        </div>

        <div class="toast-body">
            @toastMessage
        </div>
    </div>
</div>