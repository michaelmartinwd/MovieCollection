@using Microsoft.AspNetCore.Components.Forms;
@using MovieCollection.Components.Shared
@inherits MoviesBase
@rendermode InteractiveServer

@page "/movies"

<section class="py-5 text-center container">
    <div class="row py-lg-5">
        <div class="col-lg-5 col-md-8 mx-auto">
            <h1 class="fw-light">Search for Movies</h1>

            <EditForm Model="@MovieSearch" OnValidSubmit="SearchMovies" FormName="MovieSearchForm">
                <div class="input-group">
                    <InputText @bind-Value="@MovieSearch.Title" class="form-control" />
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
            </EditForm>
        </div>

    </div>
</section>

<div class="container">

    <div class="row row-cols-1 row-cols-sm-1 row-cols-md-1 g-3">

        @if (MovieSearchList is not null && MovieSearchList.Count > 0)
        {
            <Pagination CurrentPage="@CurrentPage" SearchTitle="@SearchTitle" TotalPages="@TotalPages" PageChanged="LoadPage" />
   
            @foreach (var movie in MovieSearchList)
            {
                <div class="col-12">
                    <div class="card w-100">
                        <div class="card-body">
                            <h5>@movie.Title</h5>
                            <p class="card-text"><strong>Overview: </strong>@movie.Overview</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="btn-group">
                                    <button type="button"
                                            class="btn btn-primary"
                                            @onclick="() => AddFavoriteMovieToUser(movie)">
                                        Add to Favorites
                                    </button>
                                </div>
                                <small class="text-muted">Release Date: @movie.ReleaseDate.ToShortDateString()</small>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <Pagination CurrentPage="@CurrentPage" SearchTitle="@SearchTitle" TotalPages="@TotalPages" PageChanged="LoadPage" />

        }
         
    </div>

</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div class="toast @(showToast ? "show" : "")">
        <div class="toast-header">
            <strong class="me-auto">Movie Collection</strong>
            <button type="button"
                    class="btn-close"
                    @onclick="HideToast">
            </button>
        </div>

        <div class="toast-body">
            @toastMessage  <a class="btn btn-primary" href="/favoriteMovies">View My Favorite Movies</a>
        </div>
    </div>
</div>