@using Microsoft.AspNetCore.Components.Forms;
@using MovieCollection.Components.Shared
@inherits MoviesBase

@page "/movies"

<section class="py-5 text-center container">
    <div class="row py-lg-5">
        <div class="col-lg-6 col-md-8 mx-auto">
            <h1 class="fw-light">Search for Movies</h1>
            <EditForm Model="@MovieSearch" OnValidSubmit="SearchMovies" FormName="MovieSearchForm">
                <div class="input-group">
                    <InputText @bind-Value="@MovieSearch.Title" class="form-control" />
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
            </EditForm>
        </div>
    </div>
</section>

<div class="container">

    <div class="row row-cols-1 row-cols-sm-1 row-cols-md-1 g-3">

        @if (MovieSearchList is not null && MovieSearchList.Count > 0)
        {
            <Pagination CurrentPage="@CurrentPage" SearchTitle="@SearchTitle" TotalPages="@TotalPages" PageChanged="LoadPage" />

            @foreach (var movie in MovieSearchList)
            {
                <div class="col-lg-4">
                    <div class="card w-100 h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@movie.Title <small class="text-muted">(@movie.ReleaseDate.Year)</small></h5>
                            <div class="row">
                                <div class="col-lg-12 col-md-12 col-sm-12">
                                    <p class="card-text">
                                        @(ExpandedMovies.Contains(movie.Id) || movie.Overview.Length <= 150
                                            ? movie.Overview
                                            : movie.Overview[..150] + "...")
                                        @if (movie.Overview.Length > 150)
                                        {
                                            <span class="btn btn-link"
                                                  @onclick="() => ToggleText(movie.Id)">
                                                @if (ExpandedMovies.Contains(movie.Id))
                                                {
                                                    <i class='bi bi-dash-circle' title="View Less"></i>
                                                }
                                                else
                                                {
                                                    <i class='bi bi-plus-circle' title="View More"></i>
                                                }
                                            </span>
                                        }
                                    </p>
                                </div>
                            </div>
                            <div class="mt-auto">
                                <div class="btn-group">
                                    @if (FavoriteMovies != null && FavoriteMovies.Any(fav => fav.ExternalId == movie.Id))
                                    {
                                        <button disabled type="button" class="btn btn-secondary">Marked as Favorite</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-primary" @onclick="() => AddFavoriteMovieToUser(movie)"> Add to Favorites</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <Pagination CurrentPage="@CurrentPage" SearchTitle="@SearchTitle" TotalPages="@TotalPages" PageChanged="LoadPage" />

        }

    </div>

</div>