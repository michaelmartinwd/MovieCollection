@using Microsoft.AspNetCore.Components.Forms;
@inherits MoviesBase
@rendermode InteractiveServer

@page "/movies"

<section class="py-5 text-center container">
    <div class="row py-lg-5">
        <div class="col-lg-6 col-md-8 mx-auto">
            <h1 class="fw-light">Movie Collection</h1>
            <EditForm Model="@MovieSearch" OnValidSubmit="SearchMovies" FormName="MovieSearchForm">
                <InputText @bind-Value="@MovieSearch.Title" />
                <button type="submit" class="btn btn-primary">Search</button>
            </EditForm>

        </div>
    </div>
</section>

<div class="container">

<div class="row row-cols-1 row-cols-sm-1 row-cols-md-1 g-3">

@foreach(var movie in MovieSearchList)
{
  <div class="col-12">
    <div class="card w-100">
                <strong>Title: </strong>@movie.Title
                <div class="card-body">
                    <p class="card-text"><strong>Overview: </strong>@movie.Overview</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="btn-group">
                                <button type="button"
                                        class="btn btn-primary"
                                        @onclick="() => AddFavoriteMovieToUser(movie)">
                                    Add to Favorites
                                </button>
                      </div>
                        <small class="text-muted">Release Date: @movie.ReleaseDate.ToShortDateString()</small>
                    </div>
                </div>
            </div>
        </div>
}
</div>

</div>