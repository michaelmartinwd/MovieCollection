@page "/"

<PageTitle>Home</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-3 col-md-6 col-sm-12 mb-3">
            <div class="card">
                 <i class="bi bi-search" style="font-size: 5rem; margin: 0 auto;"></i>
                <div class="card-body">
                    <h5 class="card-title">Search for Movies</h5>
                    <p class="card-text">Find movies from accessing the TMDB API and favorite them!</p>
                    <a href="/movies" class="btn btn-primary">Search Movies</a>
                </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 col-sm-12 mb-3">
        <div class="card">
            <i class="bi bi-film" style="font-size: 5rem; margin: 0 auto;"></i>
            <div class="card-body">
                <h5 class="card-title">My Favorite Movies</h5>
                <p class="card-text">View all your favorite movies and edit them!</p>
                <a href="/favoritemovies" class="btn btn-primary">View Movie Collection</a>
            </div>
    </div>
</div>
    </div>
    </div>



